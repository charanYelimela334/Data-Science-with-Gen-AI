━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
## DATABASE SCHEMA (MySQL via Django ORM)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

All models defined in Django apps. Use Django ORM only. No raw SQL.

APP: accounts
  Model: User (extends AbstractBaseUser)
    - id              AutoField PK
    - email           EmailField UNIQUE
    - password        (Django hashed — bcrypt hasher)
    - profile_status  CharField choices: pending | verified | open_to_work
    - created_at      DateTimeField auto_now_add

APP: profiles
  Model: BasicInfo
    - user            OneToOneField → User
    - first_name      CharField
    - last_name       CharField
    - phone           CharField
    - dob             DateField null
    - location        CharField
    - linkedin        URLField null
    - github          URLField null

  Model: Skill
    - user            ForeignKey → User
    - skill_name      CharField
    - level           CharField choices: Beginner | Intermediate | Expert

  Model: Experience
    - user            ForeignKey → User
    - title           CharField
    - company         CharField
    - duration        CharField
    - description     TextField
    - responsibilities TextField

  Model: Project
    - user            ForeignKey → User
    - title           CharField
    - description     TextField
    - technologies    CharField  (comma-separated)
    - duration        CharField

  Model: Education
    - user            ForeignKey → User
    - degree          CharField
    - institution     CharField
    - year            CharField
    - cgpa            CharField null

  Model: Certification
    - user            ForeignKey → User
    - name            CharField
    - issuer          CharField
    - year            CharField

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
## DJANGO REST API ENDPOINTS
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

All endpoints under /api/. Use Django REST Framework (DRF).
Authentication: JWT tokens via djangorestframework-simplejwt.

POST   /api/parse/
  - Accepts: multipart/form-data with resume PDF file
  - Action: Extract text → GPT-4o parse → auto-create user account
            → generate password → send credentials email
  - Returns: { "status": "success", "message": "Check your email to login." }

POST   /api/auth/login/
  - Accepts: { "email": "", "password": "" }
  - Returns: { "access": "<JWT>", "refresh": "<JWT>", "user_id": 1 }

GET    /api/profile/
  - Headers: Authorization: Bearer <JWT>
  - Returns: Full profile JSON (basic_info + skills + experience +
             projects + education + certifications)

PUT    /api/profile/update/
  - Headers: Authorization: Bearer <JWT>
  - Accepts: Full profile JSON with corrections
  - Action: Update all profile tables + set status = open_to_work
  - Returns: { "status": "success", "message": "Profile verified!" }

GET    /api/board/
  - Public endpoint (no auth)
  - Returns: List of all users where profile_status = open_to_work
             Fields: first_name, last_name, location, skills[], linkedin

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
## STREAMLIT FRONTEND PAGES
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

frontend/api/client.py
  - Single file with all API call functions
  - Functions: parse_resume(file), login(email, password),
               get_profile(token), update_profile(token, data),
               get_board()
  - All functions use requests library
  - BASE_URL loaded from .env

pages/upload.py
  - st.file_uploader for PDF
  - On Submit → call client.parse_resume(file)
  - Show spinner while parsing
  - On success → show "Check your email!" message
  - On error → show error clearly

pages/login.py
  - Email + password input fields inside st.form
  - On Login → call client.login(email, password)
  - On success → store JWT token in st.session_state["token"]
  - Redirect to verify page

pages/verify.py
  - Requires st.session_state["token"] — redirect to login if missing
  - Call client.get_profile(token) on load
  - Render all fields as editable st.text_input / st.selectbox
  - On Save → call client.update_profile(token, corrected_data)
  - Show success: "Profile verified! You are now Open to Work ✅"

pages/profile_board.py
  - Call client.get_board() on load
  - Display as card grid: name, location, skills badges, LinkedIn button

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
## AI EXTRACTION CONTRACT (gpt_extractor.py)
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Model       : gpt-4o
Temperature : 0
Output      : Pure JSON only (no markdown, no explanation)
Fields      : basic_info, skills[], experience[], projects[],
              education[], certifications[]
Skill level : Auto-infer as Beginner / Intermediate / Expert
Null fields : Use null, never empty string

